+// mod-custom-races: the looks a race keeps beyond the five bytes of the stock packets, for EsteriaAppearance.dll of the
+// game client: 0 none, 1 a sixth byte (Highmountain Tauren, Earthen), 2 a 64-bit number (Haranir). Saved in
+// characters.extraAppearance, carried in UNIT_FIELD_PADDING (the high half in OBJECT_FIELD_PADDING). Declared here and
+// not in a header, so that the change compiles only the files that use it. In DBCStores.cpp.
+uint8 ExtraAppearanceKind(uint8 race);
+
+namespace
+{
+    void SetExtraAppearance(Player* player, uint8 kind, uint64 value)
+    {
+        if (kind == 1)
+            player->SetByteValue(UNIT_FIELD_PADDING, 0, uint8(value));
+        else if (kind == 2)
+        {
+            player->SetUInt32Value(UNIT_FIELD_PADDING, uint32(value));
+            player->SetUInt32Value(OBJECT_FIELD_PADDING, uint32(value >> 32));
+        }
+    }
+
+    uint64 GetExtraAppearance(Player const* player, uint8 kind)
+    {
+        if (kind == 1)
+            return player->GetByteValue(UNIT_FIELD_PADDING, 0);
+        if (kind == 2)
+            return uint64(player->GetUInt32Value(UNIT_FIELD_PADDING)) | (uint64(player->GetUInt32Value(OBJECT_FIELD_PADDING)) << 32);
+        return 0;
+    }
+}
+
