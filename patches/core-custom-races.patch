+// mod-custom-races: a race a module made playable leans on a stock race (0: on none) - it starts in that race's
+// outfits and may have the skills that race may have. Declared by the module itself, so that no header changes and
+// the build stays short.
+void SetRaceBase(uint8 race, uint8 base);
+
+static std::array<uint8, 64> sRaceBase = {};
+
+void SetRaceBase(uint8 race, uint8 base)
+{
+    if (race < sRaceBase.size())
+        sRaceBase[race] = base;
+}
+
+uint32 RaceMaskOf(uint8 race)
+{
+    if (race >= 1 && race <= 32)
+        return uint32(1) << (race - 1);
+    if (race < sRaceBase.size() && sRaceBase[race] >= 1 && sRaceBase[race] <= 32)
+        return uint32(1) << (sRaceBase[race] - 1);
+    return 0;
+}
+
 CharStartOutfitEntry const* GetCharStartOutfitEntry(uint8 race, uint8 class_, uint8 gender)
 {
+    if (race < sRaceBase.size() && sRaceBase[race])
+        race = sRaceBase[race];
     std::map<uint32, CharStartOutfitEntry const*>::const_iterator itr = sCharStartOutfitMap.find(race | (class_ << 8) | (gender << 16));
     if (itr == sCharStartOutfitMap.end())
         return nullptr;
