#
# mod-custom-races - more playable races for Conquest of Azeroth.
#
# The game client of Conquest of Azeroth carries the models, skins and hair of races no player can choose. This
# module makes some of them playable. It needs its change to the core (patches/core-custom-races.patch, brought in
# by AFK Realm) and, in the game client of every player, its client patch, which puts the races on the race choice.
#
# Each new race leans on a stock race of its faction, its base race: it starts where that race starts, in its
# outfits, with its stats and racial abilities, and may do what that race may do (quests, items, reputations).
#
# Everything can be taken back: a race switched off (or the module) leaves no rows behind, and its characters play
# their base race until it is switched on again - then they get their race and looks back.
#
[worldserver]

#
#    CustomRaces.Enable
#        Description: The races of CustomRaces.Races can be created and played. Needs a restart.
#                     Off: none of them; their characters play their base race until they are on again.
#        Default:     1 - Enabled
#                     0 - Disabled
#

CustomRaces.Enable = 1

#
#    CustomRaces.Races
#        Description: The races that are playable, by name, separated by spaces, for example "Goblin Worgen".
#                     The races of the module:
#                     Goblin       shows armour, male and female
#                     Zandalari    shows armour, male and female
#                     Worgen       shows armour, male and female
#                     KulTiran     shows armour, male and female
#                     Vulpera      shows armour, male and female
#                     Pandaren     shows armour, male and female
#                     HighElf      shows armour, male and female
#                     FelOrc       male only (the game has no female model)
#                     Broken       male only (the game has no female model)
#                     Earthen      shows armour, male and female
#                     Drakkari     shows armour, male and female
#                     Vrykul       male only (the game has no female model)
#                     Tuskarr      male only (the game has no female model)
#                     Taunka       male only (the game has no female model)
#                     ForestTroll  male only (the game has no female model)
#                     IceTroll     male only (the game has no female model)
#                     Skeleton     male only (the game has no female model)
#                     Naga         shows no armour (its model has no places for it)
#                     NorthrendSkeleton male only (the game has no female model)
#                     LeperTroll   not tried yet
#                     Troglodyte   male only (the game has no female model)
#                     ThinHuman    male only (the game has no female model)
#                     HumanCultist not tried yet
#                     A race left out here is refused by the server; the race choice of the game client shows
#                     the races its client patch was built for (AFK Realm builds it anew after a change).
#                     None is chosen by default: each realm picks its own.
#        Default:     ""
#

CustomRaces.Races = ""

#
#    CustomRaces.Goblin.Base
#        Description: The stock race the Goblin leans on, by name: Human, Orc, Dwarf, NightElf, Undead, Tauren,
#                     Gnome, Troll, BloodElf or Draenei. It starts where a new character of that race starts, gets
#                     its quests, stats and racial abilities, and plays for its faction. Pick it before players make
#                     characters of the race: changed later, they keep their place but may change sides.
#        Default:     "Orc"
#

CustomRaces.Goblin.Base = "Orc"

#
#    CustomRaces.Zandalari.Base
#        Description: The stock race the Zandalari Troll leans on, by name: Human, Orc, Dwarf, NightElf, Undead, Tauren,
#                     Gnome, Troll, BloodElf or Draenei. It starts where a new character of that race starts, gets
#                     its quests, stats and racial abilities, and plays for its faction. Pick it before players make
#                     characters of the race: changed later, they keep their place but may change sides.
#        Default:     "Troll"
#

CustomRaces.Zandalari.Base = "Troll"

#
#    CustomRaces.Worgen.Base
#        Description: The stock race the Worgen leans on, by name: Human, Orc, Dwarf, NightElf, Undead, Tauren,
#                     Gnome, Troll, BloodElf or Draenei. It starts where a new character of that race starts, gets
#                     its quests, stats and racial abilities, and plays for its faction. Pick it before players make
#                     characters of the race: changed later, they keep their place but may change sides.
#        Default:     "Human"
#

