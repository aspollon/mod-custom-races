#
# mod-custom-races - more playable races for Conquest of Azeroth.
#
# The game client of Conquest of Azeroth carries the models, skins and hair of races no player can choose. This
# module makes them playable. It needs its change to the core (patches/core-custom-races.patch, brought in by AFK
# Realm) and, in the game client of every player, its client patch, which puts the races on the race choice.
#
# Which races there are is not fixed by the module: they are the races of the game client. The setup page of AFK
# Realm (Modules > Custom races) reads them from the client and writes what the server needs of each into this file
# (the CustomRaces.<race>.* options below). By hand, take the values from the client's ChrRaces.dbc.
#
# Each new race leans on a stock race, its base race: it starts where that race starts, in its outfits, with its
# stats and racial abilities, plays for its faction and may do what that race may do (quests, items, reputations).
#
# Everything can be taken back: a race switched off (or the module) leaves no rows behind, and its characters play
# their base race until it is switched on again - then they get their race and looks back.
#
# A race may also bring racial abilities of its own (CustomRaces.<race>.Racials below). AFK Realm writes the rows of
# those spells into CustomRaces.RacialsFolder; CoA Custom's races need no server data folder for that.
#
# A race also speaks with the voice of its base race: at the emotes (/silly, /joke and so on) the server sends that
# voice, for the game client plays voices for the stock races only - for a race of ours it has none. The rows are
# read from EmotesTextSound.dbc and, where the data folder has it, from the client's HD voice table
# HDEmotesTextSound.dbc (the laughter and crying lines sit there).
#
[worldserver]

#
#    CustomRaces.Enable
#        Description: The races of CustomRaces.Races can be created and played. Needs a restart.
#                     Off: none of them; their characters play their base race until they are on again.
#        Default:     1 - Enabled
#                     0 - Disabled
#

CustomRaces.Enable = 1

#
#    CustomRaces.Races
#        Description: The races that are playable, by their key (the English name without spaces), separated by
#                     spaces, for example "Goblin Worgen Vrykul". Each needs its options below.
#                     None is chosen by default: each realm picks its own.
#        Default:     ""
#

CustomRaces.Races = ""

#
#    CustomRaces.MoreRaces
#        Description: Race numbers above 31 (up to 63), for more than the 31 races the game client knows. Needs the
#                     64-race patch of the game client (dinput8.dll next to Ascension.exe; CoA Custom ships one) in the
#                     game of every player, and the core change of this module. AFK Realm puts the DLL of
#                     CustomRaces.MoreRacesFile next to the game while this is on (Modules > Game client > Install) and
#                     into the ZIP for the other players. A race above 32 has no bit of its own in race masks: it does
#                     what its base race may do (quests, items, skills).
#        Default:     0 - Off
#                     1 - On
#
#    CustomRaces.MoreRacesFile
#        Description: The 64-race patch (dinput8.dll) to put next to the game. AFK Realm keeps it in the race
#                     folder (_Client\dinput8.dll) when it makes race packs from CoA Custom.
#        Default:     ""
#

CustomRaces.MoreRaces = 0
CustomRaces.MoreRacesFile = ""

#
#    CustomRaces.HighRaces
#        Description: Race numbers up to 127, for the game of CoA Custom: its own exe (Ascension-b.exe, which every
#                     player starts instead of Ascension.exe) knows the races it adds under the numbers it gave
#                     them, up to 103 - Highmountain Tauren 66, Mechagnome 67, Earthen 68/69, Haranir 70/71 and so
#                     on. A race of the client then keeps its own number (no copy), and EsteriaAppearance.dll of
#                     CoA Custom, which knows its races by those numbers, gives them all their choices of looks.
#                     AFK Realm switches it on with "Races of CoA Custom's game" on the setup page.
#        Default:     0 - Off (up to 63)
#                     1 - On
#

CustomRaces.HighRaces = 0

#
#    CustomRaces.ClientRootFolder
#        Description: The files of CoA Custom that belong next to Ascension.exe: its folder files\client_root
#                     (Ascension-b.exe, EsteriaAppearance.dll with its .bin files, cursors). AFK Realm copies all
#                     of them next to the game when it installs the client patch (Modules > Game client > Install)
#                     and takes them away again when this is emptied; a file of the same name that was there
#                     before is kept as <name>.afk-backup. They go into the ZIP for the other players as
#                     well. Not read by the server.
#        Default:     ""
#

CustomRaces.ClientRootFolder = ""

#
#    CustomRaces.RacialsFolder
#        Description: Where AFK Realm writes the racial rows of the races (one .sql per race: the rows of
#                     their racial spells, from the server data folder, the game client or the race
#                     folder). The server runs the file of each race that is on at every start and takes
#                     the rows back out when the race goes off. Empty: afk-realm\races of
#                     CustomRaces.ServerDataFolder, as before.
#        Default:     ""
#

CustomRaces.RacialsFolder = ""

#
#    The options of each race, <race> being its key. The setup page of AFK Realm writes them from the game client.
#
#    CustomRaces.<race>.Source        The race's row in ChrRaces.dbc of the client: where its looks come from.
#    CustomRaces.<race>.Id            Its race number on this realm, 1 to 31, up to 63 with CustomRaces.MoreRaces, up to
#                                     127 with CustomRaces.HighRaces (where a race of the client keeps its own number):
#                                     its row's own number when that is below 32, otherwise a free number (one
#                                     no row of ChrRaces.dbc has; 14, 15, 17, 18, 21-31 in the CoA client). It
#                                     keeps it while switched off, so its characters get their race back; 0 gives
#                                     it up (its characters then stay their base race for good).
#    CustomRaces.<race>.Copy          1: the race's row is copied to its number (Source is 32 or more), 0: not.
#    CustomRaces.<race>.Name          Its name in the game.
#    CustomRaces.<race>.Prefix        ClientPrefix of its row.
#    CustomRaces.<race>.File          ClientFilestring of its row: the name of its model folder.
#    CustomRaces.<race>.MaleDisplay   MaleDisplayId of its row.
#    CustomRaces.<race>.FemaleDisplay FemaleDisplayId of its row.
#    CustomRaces.<race>.MaleOnly      1: the client has no female body for it; its characters are men.
#    CustomRaces.<race>.OwnHelmets    1: the client has helmet models for it. 0: it would show a placeholder for
#                                     every helmet, so its characters (players and bots) keep helmets hidden.
#    CustomRaces.<race>.Import        1: the race comes from the race folder (its rows and files), 0: from the client.
#    CustomRaces.<race>.Appearance    The looks it keeps beyond the five bytes of the game, for EsteriaAppearance.dll of
#                                     CoA Custom: 0 none, 1 a sixth byte (Highmountain Tauren, Earthen), 2 a 64-bit
#                                     number (Haranir). Saved in characters.extraAppearance. AFK Realm sets it.
#    CustomRaces.<race>.Icon          Its icon on the race choice (Interface\Icons\...), and IconFile, the file of it.
#    CustomRaces.ImportFolder         The race folder: one folder per race, each with race.json and files\.
#    CustomRaces.<race>.Base          The stock race it leans on, by name: Human, Orc, Dwarf, NightElf, Undead,
#                                     Tauren, Gnome, Troll, BloodElf or Draenei. Pick it before players make
#                                     characters of the race: changed later, they keep their place but may
#                                     change sides.
#    CustomRaces.<race>.Racials       The racial abilities the race brings of its own, as spell ids ("110600 110602
#                                     ..."): every one is learned at every login, and taken away at login from
#                                     characters that do not play the race. The rows of these spells (spell_dbc and
#                                     spell_script_names) the module takes over at every start from the .sql AFK
#                                     Realm writes for the race into CustomRaces.RacialsFolder, and gives back when
#                                     the race goes off again.
#    CustomRaces.ServerDataFolder     Optional: the server data folder of a server pack that keeps the racial rows of
#                                     its races in a folder of its own (Modules > Custom races > Server data). Empty
#                                     for CoA Custom: its races bring their racials without it.
#
#    Example (the Goblin of the CoA client):
#
#    CustomRaces.Goblin.Source = 9
#    CustomRaces.Goblin.Id = 9
#    CustomRaces.Goblin.Copy = 0
#    CustomRaces.Goblin.Name = "Goblin"
#    CustomRaces.Goblin.Prefix = "Go"
#    CustomRaces.Goblin.File = "Goblin"
#    CustomRaces.Goblin.MaleDisplay = 6894
#    CustomRaces.Goblin.FemaleDisplay = 6895
#    CustomRaces.Goblin.MaleOnly = 0
#    CustomRaces.Goblin.OwnHelmets = 1
#    CustomRaces.Goblin.Base = "Orc"
#    CustomRaces.Goblin.Racials = ""
#
